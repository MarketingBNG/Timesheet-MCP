# ---- Required -------------------------------------------------------------

# Zoho API Console -> Self Client -> Client ID / Client Secret
ZOHO_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ZOHO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Long-lived refresh token, exchanged from a self-client grant code.
# Scopes needed: ZohoProjects.tasks.ALL, ZohoProjects.timesheets.ALL,
#                ZohoProjects.projects.READ, ZohoProjects.portals.READ,
#                ZohoPeople.attendance.READ
ZOHO_REFRESH_TOKEN=1000.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Portal id — see the README for how to fetch it.
ZOHO_PORTAL_ID=12345678

# Your Zoho portal-login id (zpuid, a long 2839... number). Used as this
# server's key for you. NOT the same id space as ZOHO_TIMELOG_OWNER_ID below,
# and not the same as the zpuid on a task owner record.
ZOHO_USER_ID=987654321

# ---- Optional -------------------------------------------------------------

# Data centre suffix: com | in | eu | com.au | jp | com.cn
# Must match where the Zoho account lives, or every call 401s.
ZOHO_DOMAIN=com

# Zoho People employee id whose check-in/check-out times are read.
# Only needed in single-account mode — in OAuth mode attendance is looked up by
# the connected user email. Requires ZohoPeople.attendance.READ.
# ZOHO_PEOPLE_EMPLOYEE_ID=

# Your Zoho user id (ZUID, a shorter 600... number): the `id` on your entry in
# the portal user list. Zoho stamps it on your timelogs as owner_id, task owner
# records carry it as `id`, and create_task assigns with it.
# Leave it unset and the server reads it from /restapi/portals/ (login_id) on
# first use; set it to skip that call or if your portal does not report it.
# ZOHO_TIMELOG_OWNER_ID=

# Billable | Non Billable — Zoho requires one on every timelog.
ZOHO_DEFAULT_BILL_STATUS=Non Billable

# Where the JSONL audit trail of every write attempt is appended.
# AUDIT_LOG_PATH=./audit/timelog-audit.jsonl

# In-memory task cache lifetime, seconds.
# TASK_CACHE_TTL_SECONDS=300

# Max concurrent requests to Zoho. Their per-minute limits are low.
# ZOHO_MAX_CONCURRENCY=3

# Set to any value for verbose request logging on stderr.
# DEBUG=1

# ---- HTTP deployment ----------------------------------------------------
# Port the HTTP server listens on (Railway/Render set this for you).
# PORT=3000

# ---- Multi-user OAuth mode ---------------------------------------------
# Set BOTH of these to turn on per-user OAuth. Each person then connects
# their own Zoho account and all four service-account variables above
# (REFRESH_TOKEN, PORTAL_ID, USER_ID, TIMELOG_OWNER_ID) become optional.
#
# The externally reachable base URL. Register PUBLIC_URL + "/callback"
# as the redirect URI on your Zoho Server-based application.
# PUBLIC_URL=https://your-app.up.railway.app
#
# Encrypts stored Zoho refresh tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this means every user must reconnect.
# TOKEN_ENCRYPTION_KEY=
#
# Postgres connection string for the user store. Required in OAuth mode.
# Any managed Postgres works; Neon and Supabase both have a free tier.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ---- Single-account mode only ------------------------------------------
# Shared secret required in the Authorization header on /mcp.
# Used ONLY when OAuth is off. Without it /mcp is wide open.
# MCP_AUTH_TOKEN=generate-a-long-random-string
